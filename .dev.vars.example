# Contoh secret lokal untuk Cloudflare Worker.
# Jangan mengisi secret asli di file ini dan jangan commit .dev.vars.

# Lingkungan aplikasi: development | test | production
APP_ENV=development

# Secret server-side. Wajib diisi nilai acak yang kuat (minimal 16 karakter).
# Tidak boleh kosong dan tidak boleh berupa placeholder.
SESSION_SECRET=
PASSWORD_PEPPER=

# Konfigurasi autentikasi (opsional, memakai default bila kosong).
PASSWORD_PBKDF2_ITERATIONS=100000
SESSION_TTL_SECONDS=86400
ADMIN_SESSION_TTL_SECONDS=3600

# Cloudflare Turnstile (belum wajib pada Phase 3).
TURNSTILE_SECRET_KEY=

# Bootstrap SUPERADMIN local. Biarkan kosong di repository.
BOOTSTRAP_SUPERADMIN_USER_ID=
BOOTSTRAP_SUPERADMIN_PASSWORD=
